# 서버 전용 환경 변수 — 이름만 둔다. 값은 여기에 쓰지 않는다.
#
# 실제 값은 `.env.local` 에 넣는다(`.gitignore` 로 무시된다). 값은 승인된 비밀 공유 수단으로만
# 받고, Issue · PR · 댓글 · 채팅 · 터미널 출력 어디에도 남기지 않는다.
# 환경별 값 · 소유 · 앱 설정은 #78 D3-A 를 본다. 준비 절차는 docs/PROJECT_COMMANDS.md.
#
# 아래 6개는 전부 서버에서만 읽는다. NEXT_PUBLIC_ 로 옮기지 않는다.

# PostgreSQL 접속 문자열. local 은 개발자별 Docker postgres:17.
DATABASE_URL=

# 앱의 정본 origin. OAuth redirect URI 를 이 값으로만 만든다(Host 헤더를 쓰지 않는다).
# local 은 http://localhost:3000 고정 — 3000 이 아니면 등록된 callback 과 어긋난다.
APP_ORIGIN=

# Google Cloud nonprod(Testing) 프로젝트의 Web OAuth client. scope 는 openid profile 뿐이다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao canonical app 의 환경별 REST API 키와 그 키의 Client Secret.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=


# ── 브라우저에 노출되는 값 ───────────────────────────────────────────
# 위 6개와 달리 클라이언트 번들에 들어간다. secret 을 여기에 두지 않는다.

# NAVER Maps Web Dynamic Map 의 ncpKeyId(#78 D3-B). public client identifier 이고
# secret 이 아니다 — 보호 수단은 값의 비밀 유지가 아니라 Web 서비스 URL 등록이다.
# NCP Client Secret(X-NCP-APIGW-API-KEY)은 여기에도, 번들에도, 저장소에도 두지 않는다.
NEXT_PUBLIC_NAVER_MAP_KEY_ID=
